{
  "manifest_version": 3,
  "name": "Practice Studio Clipper",
  "version": "0.1.0",
  "description": "Clips a therapist's website into a vCard for Practice Studio's contact inbox.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Clip therapist contact",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
